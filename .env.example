# AX Link 개발용 환경변수 예제. 복사해서 저장소 루트에 .env 로 둔다(.env 는 깃에 올라가지 않는다).
# 앱은 AXLINK_ 로 시작하는 이름만 읽는다(app/config.py). 운영 스택 변수는 infra/prod.env.example.
#
# 도커 개발 환경(infra/docker-compose.yml)도 이 파일을 읽는다. 다만 DB·Ollama 주소는
# 컴포즈가 컨테이너망 주소로 덮으므로, 아래 주소 값은 호스트에서 직접 실행할 때만 쓰인다.

# ── 비밀값 ──
# 도구 인증정보 암호화 키(base64 32바이트). 없으면 기동마다 일회용 키가 생겨 재기동 뒤 저장된 토큰을 못 푼다.
# 이미 데이터가 있으면 원래 키를 그대로 둔다. 새로 만들면 기존 연결을 다시 등록해야 한다.
# 새로 만들 때: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AXLINK_SECRET_KEY=
# 로그인 토큰 서명 키. 개발은 비워 두면 코드의 개발 기본값을 쓴다. 운영(AXLINK_ENV=production)은 필수.
AXLINK_JWT_SECRET=
# development | production. production 이면 위 두 값이 없거나 기본값일 때 기동하지 않는다
AXLINK_ENV=development

# ── DB (호스트 실행용) ──
AXLINK_DATABASE_URL=postgresql://axlink:axlink@localhost:15432/axlink

# ── 모델 (호스트 실행용) ──
# 생성 모델 서버 기본 주소. 관리 화면에서 고른 주소(DB llm_setting)가 있으면 그쪽을 쓴다
AXLINK_OLLAMA_BASE_URL=http://localhost:11434
# 임베딩(bge-m3) 서버 주소. 비우면 AXLINK_OLLAMA_BASE_URL 을 쓴다
AXLINK_EMBEDDING_BASE_URL=
# DB 에 활성 모델이 없을 때의 기본 생성 모델
AXLINK_LLM_MODEL=gemma4:31b-cloud
AXLINK_EMBEDDING_MODEL=bge-m3

# ── 기타 ──
AXLINK_CORS_ORIGINS=http://localhost:5173
# 업로드 문서 보관 위치(저장소 기준 상대경로 또는 절대경로)
AXLINK_DOCUMENT_ROOT=var/documents

# ── 시험 전용 (tests/) ──
# 시험 DB 는 infra/docker-compose.test.yml 로 띄우고 127.0.0.1 로 적는다
# AXLINK_DATABASE_URL=postgresql://axlink:axlink@127.0.0.1:15433/axlink_test
# 실모델·실원천 시험을 켤 때만
# AXLINK_LIVE=1
# AXLINK_GH_TOKEN=
# AXLINK_GH_REPO=owner/repo
