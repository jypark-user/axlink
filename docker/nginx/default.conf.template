# AX Link 웹. 화면은 정적 파일이고 /api 만 API 컨테이너로 넘긴다. 같은 출처라 CORS 가 필요 없다.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # 문서 업로드. API 쪽 제한보다 작으면 여기서 먼저 끊긴다.
    client_max_body_size 100m;

    location /api/ {
        proxy_pass ${AXLINK_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # AI 답변은 SSE 로 조각조각 온다. 모아 두면 화면에 한 번에 나온다.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 빌드 산출물은 파일명에 해시가 붙어 오래 캐시해도 된다.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /version.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # 화면 주소를 직접 열거나 새로고침해도 index.html 이 받는다(클라이언트 라우팅).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
