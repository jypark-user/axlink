# infra/docker-compose.redmine.yml 의 비밀값. 이 파일을 저장소 밖으로 복사해 값을 채운다.
# 값은 무작위로 만든다. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
REDMINE_DB_PASSWORD=
REDMINE_SECRET_KEY_BASE=
# 호스트 포트(127.0.0.1 로만 연다)
REDMINE_HOST_PORT=3000
# 앱 API 가 붙은 네트워크와 중계 대상 컨테이너. 5174 기준값이다
AXLINK_APP_NETWORK=axlink-int_default
AXLINK_RELAY_TARGET=axlink-int-api
