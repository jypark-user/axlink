# AX Link 운영 스택 변수 예제 (infra/docker-compose.prod.yml).
# Portainer 에서는 스택의 Environment variables 에 같은 이름으로 넣는다. 실제 값이 든 파일은 깃에 올리지 않는다.

# ── 이미지 ──
# 레지스트리와 저장소 접두. 예: ghcr.io/jypark-user  (미정: 사용할 레지스트리)
AXLINK_IMAGE_PREFIX=
# 배포할 버전 태그. 되돌릴 때는 이 값만 이전 태그로 바꾼다
AXLINK_VERSION=

# ── 비밀값 (필수, 없으면 배포가 실패한다) ──
# DB 비밀번호. URL 에 그대로 들어가므로 영문·숫자만 쓴다
AXLINK_DB_PASSWORD=
# 로그인 토큰 서명 키. 32자 이상 무작위. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
AXLINK_JWT_SECRET=
# 도구 인증정보 암호화 키(base64 32바이트). 예: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# 기존 데이터를 옮길 때는 반드시 원래 키를 그대로 쓴다. 새 키로는 저장된 토큰을 풀 수 없다
AXLINK_SECRET_KEY=

# ── 접속 ──
# 브라우저가 여는 주소 (미정: 도메인·HTTPS 프록시)
AXLINK_PUBLIC_ORIGIN=http://localhost:8088
AXLINK_HTTP_BIND=0.0.0.0
AXLINK_HTTP_PORT=8088

# ── 모델 ──
# 같은 스택의 Ollama 를 쓰면 1, 다른 서버의 Ollama 를 쓰면 0
AXLINK_BUNDLED_OLLAMA=1
AXLINK_OLLAMA_TAG=0.33.1
# 생성 모델 서버(클라우드 모델은 이 Ollama 가 로그인돼 있어야 한다)
AXLINK_OLLAMA_BASE_URL=http://ollama:11434
# 임베딩(bge-m3) 서버
AXLINK_EMBEDDING_BASE_URL=http://ollama:11434
AXLINK_LLM_MODEL=gemma4:31b-cloud
